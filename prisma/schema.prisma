model Payment {
  id          String        @id @default(cuid())
  centerId    String
  userId      String
  amount      Float
  currency    String        @default("INR")
  status      PaymentStatus @default(CREATED)
  paymentType PaymentType

  // Razorpay fields
  razorpayOrderId   String  @unique
  razorpayPaymentId String?
  razorpaySignature String?

  // Reference to what was paid for
  bookingIds    String[] // Array of booking IDs for slot bookings
  userPackageId String? // For package purchases

  // Refund tracking
  refundId     String?
  refundAmount Float?
  refundedAt   DateTime?
  refundMethod RefundMethod?

  // ─── Booking lease (duplicate-booking guard) ──────────────────────
  //
  // The CREATED→CAPTURED flip alone is NOT enough to serialise booking
  // creation: it leaves the row as CAPTURED-with-no-bookingIds for the
  // several seconds the booking transaction runs, and every recovery
  // path (verify / webhook / reconciler) reads that state as "captured
  // but unfulfilled → book it now". Two paths landing in that window
  // both booked, and the customer got double the sessions they paid for.
  //
  // `bookingClaimAt` is a lease covering the *whole* fulfilment window,
  // taken atomically with the capture flip and released when fulfilment
  // finishes (or fails). Stale leases (older than BOOKING_LEASE_MS, see
  // src/lib/payment-claim.ts) are stealable so a crashed finalizer can
  // never wedge a payment permanently. `bookingClaimBy` records which
  // path holds it, purely for log forensics.
  bookingClaimAt DateTime?
  bookingClaimBy String?

  // Metadata
  metadata      Json? // Store any extra info (slot details, package info, etc.)
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center  Center   @relation(fields: [centerId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  refunds Refund[]

  @@index([userId])
  @@index([centerId, status])
  @@index([razorpayOrderId])
  @@index([status])
  // Admin money columns look payments up by booking id (bookingIds && ARRAY[...]);
  // only a GIN index can serve that array-overlap filter.
  @@index([bookingIds], type: Gin)
}

model Refund {
  id                  String       @id @default(cuid())
  bookingId           String
  paymentId           String? // Optional: null for wallet-only refunds on non-online bookings
  amount              Float // Amount in rupees
  method              RefundMethod
  status              RefundStatus @default(INITIATED)
  reason              String
  razorpayRefundId    String?
  walletTransactionId String?
  initiatedById       String // Admin user who initiated the refund
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  booking     Booking  @relation(fields: [bookingId], references: [id])
  payment     Payment? @relation(fields: [paymentId], references: [id])
  initiatedBy User     @relation("AdminRefunds", fields: [initiatedById], references: [id])

  @@index([bookingId])
  @@index([paymentId])
}

// DEPRECATED — nothing reads or writes this table any more.
//
// Operator allocation is resolved from availability alone: each OPERATOR
// `CenterMembership` carries weekly `MembershipAvailability` windows and
// a `priority`, and the engine assigns the highest-priority operator who
// is available for the slot and not already on an overlapping booking
// (see `src/lib/operatorAssign.ts`). Per-machine pinning, and the
// weekday filter below, no longer influence anything. The table is kept
// so existing rows aren't destroyed; safe to drop in a later migration.
//
// An OPERATOR user (someone who runs a bowling machine) assigned to a
// specific machine at a specific center, optionally restricted to a
// set of weekdays.
//
// Two ways to identify the machine:
//   - `machineId`     legacy MachineId enum (GRAVITY/YANTRA/…). Used by
//                     ABCA-style MACHINE_PITCH centers.
//   - `machineRowId`  FK to the `Machine` table. Used by RESOURCE_BASED
//                     centers (Toplay et al.) where the assignable unit
//                     is a `Machine` row, not a global enum.
//
// Exactly one of the two is set. Duplicate-prevention is enforced via
// partial unique indexes (defined in raw SQL inside the accompanying
// migration — Prisma's schema DSL can't express partial uniques).
model OperatorAssignment {
  id           String     @id @default(cuid())
  centerId     String
  userId       String
  machineId    MachineId?
  machineRowId String?
  days         Int[] // Day-of-week filter: 0=Sun..6=Sat. Empty = all days.
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  center       Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  machineRow   Machine?   @relation(fields: [machineRowId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([machineRowId])
}

model CashPaymentUser {
  id        String   @id @default(cuid())
  centerId  String
  userId    String
  enabledBy String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@unique([centerId, userId])
  @@index([centerId])
}

model PromotionalOffer {
  id            String            @id @default(cuid())
  centerId      String
  name          String
  startDate     DateTime          @db.Date
  endDate       DateTime          @db.Date
  timeSlotStart String? // HH:MM — null means all day
  timeSlotEnd   String? // HH:MM — null means all day
  days          Int[] // Day-of-week filter: 0=Sun..6=Sat. Empty = all days.
  machineIds    MachineId[] // empty = applies to all machines (legacy enum, ABCA)
  pitchTypes    PitchType[] // empty = applies to all pitches (legacy enum, ABCA)
  // Resource-based targeting. Empty = applies to all (no filter on
  // that axis). Mixed axes intersect.
  machineRowIds String[]          @default([]) // Machine.id FKs (Toplay)
  categories    BookingCategory[] @default([]) // booking category targeting
  discountType  DiscountType
  discountValue Float // percentage (0-100) or flat ₹ amount
  isActive      Boolean           @default(true)
  appliesTo     String            @default("ALL") // "ALL" = all users, "SPECIAL" = special users only
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId, startDate, endDate])
  @@index([centerId, isActive])
}

model RecurringSlotDiscount {
  id              String            @id @default(cuid())
  centerId        String
  enabled         Boolean           @default(true)
  days            Int[] // Array of day-of-week numbers: 0=Sun, 1=Mon, ..., 6=Sat
  slotStartTime   String // HH:MM format e.g. "08:00"
  slotEndTime     String // HH:MM format e.g. "08:30"
  machineIds      MachineId[] // empty = applies to all machines (legacy enum)
  pitchTypes      PitchType[] // empty = applies to all pitches (legacy enum)
  // Resource-based targeting. Empty = applies to all on that axis.
  machineRowIds   String[]          @default([]) // Machine.id FKs (Toplay)
  categories      BookingCategory[] @default([]) // booking-category targeting
  oneSlotDiscount Float // flat ₹ discount for 1 matching slot
  twoSlotDiscount Float // flat ₹ discount for 2 consecutive matching slots
  appliesTo       String            @default("ALL") // "ALL" = all users, "SPECIAL" = special users only
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId, enabled])
}

// ─── Ledger: manually recorded revenue & expenses ────────────────────
//
// Money that never flows through the booking/package/Razorpay rails
// still has to be accounted for: a walk-in who paid cash at the desk, a
// net repair bill, the electricity bill, a sidearm specialist's payout.
// A `LedgerEntry` is one such hand-entered line item.
//
// One table holds both sides of the book, discriminated by `kind`:
//   REVENUE — money IN  (revenueCategory / customerName / serviceDate)
//   EXPENSE — money OUT (expenseCategory / expenseSubcategory / paidTo)
// The shared columns (amount, entryDate, entryTime, paymentMethod,
// remarks, recordedBy) apply to both. Kind-specific columns are
// nullable at the DB level and enforced per-kind in `src/lib/ledger.ts`.
//
// Center-scoped like every other financial table. `recordedById` is the
// admin/moderator who created the row — captured server-side from the
// session, never accepted from the client.
model LedgerEntry {
  id       String          @id @default(cuid())
  centerId String
  kind     LedgerEntryKind

  // ── REVENUE-only ──
  // Which service the money was for. Mirrors the bookable categories
  // plus OTHER for anything that isn't one of them.
  revenueCategory LedgerRevenueCategory?
  customerName    String?

  // ── Session timing (REVENUE only, all optional) ──
  //
  // When the session this entry relates to actually takes place —
  // deliberately separate from `entryDate`/`entryTime` (when the money
  // changed hands), since a customer can pay today for a slot next
  // week. Recorded as a range so the full session duration is captured.
  // Expenses have no session behind them (a repair bill or a utility
  // payment isn't tied to a slot), so the expense form omits these and
  // the API nulls them out on write.
  serviceDate      DateTime? @db.Date
  serviceStartTime String? // "HH:MM" IST
  serviceEndTime   String? // "HH:MM" IST

  // ── EXPENSE-only ──
  expenseCategory    LedgerExpenseCategory?
  // Subcategory code from the per-category catalog in lib/ledger.ts
  // (e.g. "NET_REPAIR", "LEATHER_BALL"). Stored as text rather than an
  // enum so the catalog can grow without a migration.
  expenseSubcategory String?
  description        String?
  // Vendor / person the money was paid to.
  paidTo             String?

  // ── Shared ──
  amount        Float
  // Date + time the money was actually received / paid.
  entryDate     DateTime            @db.Date
  entryTime     String // "HH:MM" IST
  paymentMethod LedgerPaymentMethod
  remarks       String?

  // Who physically handled the money — the staff member who took the
  // cash or whose account it landed in. A real User rather than an enum
  // of names, so the list tracks the center's actual roster. Defaults
  // to whoever is adding the entry.
  collectedById String?
  // Who keyed the entry in. Always stamped from the session, never
  // accepted from the request body, and never rewritten on edit.
  recordedById  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center      Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  recordedBy  User   @relation("LedgerEntriesRecorded", fields: [recordedById], references: [id])
  collectedBy User?  @relation("LedgerEntriesCollected", fields: [collectedById], references: [id])

  // Dashboard/report scans: "all entries of kind K at center C in range".
  @@index([centerId, kind, entryDate])
  // "Recorded By" filter.
  @@index([centerId, recordedById])
  // "Collected By" filter.
  @@index([centerId, collectedById])
}

enum LedgerEntryKind {
  REVENUE
  EXPENSE
}

// Revenue buckets = the bookable categories, so a manual entry can be
// attributed to the same service a system booking would have been —
// and lands in the same bucket on the dashboard's Revenue by Category
// chart. These mirror `BookingCategory` one-for-one (CORPORATE_BATCH
// and MATCH_SIMULATION individually, NOT the MATCH_PRACTICE UI
// umbrella, which is not a BookingCategory and has no chart bucket).
// OTHER is the only extra: miscellaneous income with no service behind
// it, which gets its own bucket.
enum LedgerRevenueCategory {
  MACHINE
  NET
  SIDEARM
  COACHING
  FULL_COURT
  CORPORATE_BATCH
  MATCH_SIMULATION
  OTHER
}

enum LedgerExpenseCategory {
  REPAIRS_MAINTENANCE
  BALLS
  STAFF_PAYMENTS
  UTILITIES_CONSUMABLES
  MISCELLANEOUS
}

// How the money moved. Deliberately tiny: WHO handled it is a separate
// question, answered by `LedgerEntry.collectedById` (a real User at the
// center) rather than by hardcoding staff names into an enum that would
// go stale every time someone joins or leaves.
enum LedgerPaymentMethod {
  CASH
  ONLINE
  OTHER
}

// ─── Cricket Store ──────────────────────────────────────────────────
//
// The in-app store (Admin -> Cricket Store, user /shop): cricket gear —
// bats first, then gloves, thigh guards and the rest. Deliberately NOT
// center-scoped: PlayOrbit sells one catalog to every customer, whichever
// center they book at, and hand-pick/collection happens at one configured
// location (initially Toplay). Managed by store admins
// (User.isStoreAdmin) and super admins, never by center admins. Launch
// state ("Coming soon") and the pickup note are the global
// MARKETPLACE_CONFIG policy, not columns here.

model MarketplaceProduct {
  id String @id @default(cuid())

  name        String
  // Category code validated against the catalog in src/lib/marketplace.ts
  // (BAT, GLOVES, THIGH_GUARD, ...). Text rather than a Postgres enum so
  // the catalog can grow without a migration — same rule as the ledger's
  // expense subcategories.
  category    String
  brand       String?
  sku         String?
  description String?

  // Selling price and the strike-through MRP, both in INR.
  price Float
  mrp   Float?

  // null = stock not tracked (only the inStock flag matters).
  stockQty Int?
  inStock  Boolean @default(true)

  // Published to /shop. New products start hidden so an admin can add
  // images before anyone sees them.
  isActive     Boolean @default(false)
  isFeatured   Boolean @default(false)
  displayOrder Int     @default(0)

  // Size labels shown as chips ("SH", "Harrow", "Men's L") — enough for
  // bats / gloves / guards without a full variant model.
  sizes String[] @default([])
  // [{ label, value }] free-form spec rows (willow grade, weight, ...).
  specs Json?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?                     @relation("MarketplaceProductsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  images    MarketplaceProductImage[]
  interests MarketplaceInterest[]

  // /shop listing: published products, per category.
  @@index([isActive, category])
  @@index([displayOrder])
}

// Product photos, stored in Postgres (bytea) and served by
// /api/shop/images/[id] with immutable caching — an image row is never
// edited, only replaced, so its id is a safe cache key. Kept off every
// list query (`data` is selected only by the image route).
model MarketplaceProductImage {
  id          String   @id @default(cuid())
  productId   String
  data        Bytes
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?
  // 0 = primary image (the card thumbnail).
  sortOrder   Int      @default(0)
  alt         String?
  createdAt   DateTime @default(now())

  product MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// "Notify me when available" — a signed-in user's interest in a product
// while the store is in Coming Soon mode. One row per user per product;
// admins read them as launch leads.
model MarketplaceInterest {
  id        String   @id @default(cuid())
  productId String
  userId    String
  createdAt DateTime @default(now())

  product MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
}

// Delivery addresses on the user's profile (/profile). Global, not
// center-scoped — a user's home address does not change with the center
// they book at. At most one default per user, enforced in the API.
model UserAddress {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
