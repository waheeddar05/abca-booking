generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

// ─── Multi-Center Foundation ─────────────────────────────────────────
//
// A "Center" is an independent operational unit (e.g. ABCA, Toplay).
// Each center has its own infrastructure, machines, admins, payment
// gateway and config. Most domain rows (Booking, Slot, Package, etc.)
// are center-scoped via a `centerId` FK.
//
// Resolution order for any configurable value:
//   center-specific row  →  global row (centerId IS NULL)  →  hardcoded default

model Center {
  id           String  @id @default(cuid())
  slug         String  @unique // e.g. "abca", "toplay" — used in URLs and code
  name         String
  shortName    String?
  description  String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  // Booking engine selection — different centers may use different
  // booking models (legacy machine/pitch vs. resource-pool).
  bookingModel BookingModel @default(MACHINE_PITCH)

  // Contact + location
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  latitude     Float?
  longitude    Float?
  contactPhone String?
  // Multiple per-center contacts surfaced on the landing page's
  // 'Ready to play' strip. Each entry: { name: string|null,
  // number: string }. Keeping the single contactPhone column for
  // back-compat; readers prefer contactPhones when non-empty and
  // fall back to a single-entry list synthesised from contactPhone
  // otherwise. JSON instead of a side table to avoid a join on
  // every landing-page hit.
  contactPhones Json?
  contactEmail String?
  mapUrl       String?
  logoUrl      String?
  themeColor   String?

  // Per-center Razorpay credentials. Keep null to fall back to env.
  // SECURITY: keySecret is plaintext today — flag for encryption-at-rest
  // before exposing edit UI to non-super-admins.
  razorpayKeyId         String?
  razorpayKeySecret     String?
  razorpayWebhookSecret String?

  // Free-form per-center configuration (operating hours, holidays, etc.)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         CenterMembership[]
  resources           Resource[]
  machines            Machine[]
  bookings            Booking[]
  slots               Slot[]
  packages            Package[]
  blockedSlots        BlockedSlot[]
  payments            Payment[]
  promotionalOffers   PromotionalOffer[]
  recurringDiscounts  RecurringSlotDiscount[]
  cashPaymentUsers    CashPaymentUser[]
  operatorAssignments OperatorAssignment[]
  centerPolicies      CenterPolicy[]
  wallets             Wallet[]
  ledgerEntries       LedgerEntry[]
}

enum BookingModel {
  // Legacy: Booking is unique on (date, startTime, machineId, pitchType).
  // Used by ABCA. Each machine has its own implicit "lane".
  MACHINE_PITCH
  // Toplay: Bookings consume named Resources (nets, courts, staff).
  // Availability = "all required resources free for this slot."
  RESOURCE_BASED
}

model CenterMembership {
  id        String         @id @default(cuid())
  userId    String
  centerId  String
  role      MembershipRole
  isActive  Boolean        @default(true)
  // Optional per-center metadata (e.g. coach specialties, sidearm staff
  // weekly schedule, operator-priority overrides). Free-form to avoid
  // schema churn while the resource-based engine evolves.
  metadata  Json?
  // Tie-breaker when multiple memberships are equally eligible at the
  // same slot — lower priority wins (1 = first pick, 100 = last). Used
  // by the resource-based engine's `pickStaffFor` and `autoAssignCoach`
  // when the user doesn't pin a specific person. Default 100 keeps
  // existing rows out of the front of any ordering until an admin
  // explicitly ranks them. Applies primarily to SIDEARM_SPECIALIST +
  // COACH; OPERATOR has its own per-machine assignment table.
  priority  Int            @default(100)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user             User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  center           Center                        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  availability     MembershipAvailability[]
  dateAvailability MembershipDateAvailability[]

  @@unique([userId, centerId, role])
  @@index([centerId, role])
  @@index([userId])
}

enum MembershipRole {
  ADMIN
  // Restricted admin. Has access to most of the admin panel but cannot
  // touch critical surfaces: Users, Settings, and the center config
  // ("My Center") are hidden, and booking cancellation/refund/staff
  // reassignment plus all package mutations are blocked. The
  // staff-management tabs (Sidearm / Personal Coach / Ground Staff) are
  // fully open — same permissions as ADMIN there, scoped to those staff
  // roles. Enforced in both the API guards and the admin UI.
  MODERATOR
  OPERATOR
  COACH
  // Renamed from SIDEARM_STAFF — same role, clearer label. The Postgres
  // enum value is renamed in-place via the migration; no data movement.
  SIDEARM_SPECIALIST
  // Center-side facility staff. Default contact for Cricket Nets and
  // Full Indoor Court bookings — surfaces as a "Call" / name pill on
  // the user's booking card, similar to how bowling-machine operators
  // appear for MACHINE bookings. Multiple ground-staff memberships are
  // ranked by CenterMembership.priority (lower = first contact).
  GROUND_STAFF
}

// Weekly recurring availability for a coach or sidearm specialist.
// A row restricts the specialist to a weekday + time window (e.g. only
// Mon–Fri 17:00–21:00). Multiple rows on the same day stack as a union
// of windows. Empty list = unavailable by default (the engine no longer
// treats "no rows" as "always available").
//
// Effective date range: each row carries an OPTIONAL [effectiveFrom,
// effectiveTo] window (inclusive, IST). The weekly schedule only applies
// to dates inside that window — e.g. "every Mon/Wed/Fri 06:00–09:00
// between 01-Jan-2026 and 31-Dec-2026". Null on either bound means
// "no limit on that side", so legacy rows (both null) keep applying
// indefinitely. All rows saved together share the same effective range
// (it's a schedule-level attribute persisted per row for simplicity).
model MembershipAvailability {
  id            String    @id @default(cuid())
  membershipId  String
  // 0 = Sunday, 6 = Saturday — IST day-of-week (matches the rest of the
  // codebase; see resource-booking.ts → getISTDayOfWeek).
  dayOfWeek     Int
  // HH:MM in IST, e.g. "17:00".
  startTime     String
  endTime       String
  // Inclusive effective window in IST. Stored as @db.Date so timezone
  // math doesn't shift them across midnight. Null = unbounded on that
  // side (applies indefinitely).
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  membership CenterMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, dayOfWeek])
}

// DEPRECATED — standalone "Date Range Availability".
//
// This separate date-range feature has been retired in favour of the
// Effective Date Range now built into MembershipAvailability (weekly
// schedule + [effectiveFrom, effectiveTo]). The engine no longer reads
// this table and the admin/user editors for it have been removed.
//
// The model + table are kept only so existing rows aren't dropped (a
// non-destructive change). Nothing in the app reads or writes it; treat
// it as inert legacy data. A future migration can drop it once we're
// confident no center relies on the old rows.
model MembershipDateAvailability {
  id           String   @id @default(cuid())
  membershipId String
  // Inclusive date range in IST. fromDate / toDate are stored as
  // @db.Date so timezone math doesn't shift them across midnight.
  fromDate     DateTime @db.Date
  toDate       DateTime @db.Date
  // Optional time window inside each day in the range. Null on either
  // bound means "all day". HH:MM IST strings (e.g. "17:00").
  startTime    String?
  endTime      String?
  isActive     Boolean  @default(true)
  // Free-form note ("Tournament block", "Camp dates"). Not used by
  // the engine — just shown in the admin editor.
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership CenterMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, fromDate, toDate])
}

// A physical, bookable thing at a center: a net, a turf wicket, a court.
// Resources are the "supply side" of the resource-based booking model.
// (ABCA centers can ignore this table entirely until they migrate.)
model Resource {
  id           String           @id @default(cuid())
  centerId     String
  name         String // "Indoor Net 1", "Outdoor Turf 1"
  type         ResourceType
  category     ResourceCategory
  capacity     Int              @default(1) // future: a wicket that can host two batsmen
  isActive     Boolean          @default(true)
  displayOrder Int              @default(0)
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  center             Center                      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  machines           Machine[]
  bookingAssignments BookingResourceAssignment[]

  @@index([centerId, type])
  @@index([centerId, isActive])
}

enum ResourceType {
  NET
  TURF_WICKET
  CEMENT_WICKET
  COURT // a logical resource composed of multiple nets (e.g. full indoor court)
}

enum ResourceCategory {
  INDOOR
  OUTDOOR
}

// Catalog of machine types (Yantra, Leverage, Gravity, …). Adding a new
// machine model is a data-only operation: insert a row, then create
// per-center Machine rows.
model MachineType {
  id          String   @id @default(cuid())
  code        String   @unique // "YANTRA", "LEVERAGE", "GRAVITY"
  name        String
  ballType    BallType
  description String?
  // Public image URL shown on the user-facing machine picker (e.g.
  // `/images/yantra-machine.jpeg`). Inherited by every Machine instance
  // of this type so any Yantra at any center renders the Yantra photo.
  imageUrl    String?
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  machines Machine[]
}

// A specific machine instance at a specific center. ABCA's existing four
// machines are seeded with `legacyMachineId` set, so the existing enum-
// based booking code keeps working untouched while new code can address
// machines by `Machine.id`.
model Machine {
  id                  String      @id @default(cuid())
  centerId            String
  machineTypeId       String
  // Bridge to the legacy MachineId enum — set for ABCA's existing machines,
  // null for any newly-created machine at any center. To be deprecated once
  // every booking query reads from this table.
  legacyMachineId     MachineId?
  name                String // "Yantra 1"
  shortName           String?
  resourceId          String? // optional: which net/wicket this machine sits on
  isActive            Boolean     @default(true)
  displayOrder        Int         @default(0)
  // Per-instance pitch + ball compatibility. Drives the user-facing
  // pitch/ball chips on the resource-based slot picker, replacing the
  // legacy global `MACHINE_PITCH_CONFIG` policy for any new center.
  // ABCA's four seeded machines are backfilled from that policy in the
  // accompanying migration so the legacy ABCA flow stays unchanged while
  // new centers (Toplay, …) configure compatibility per machine row.
  supportedPitchTypes PitchType[] @default([])
  supportedBallTypes  BallType[]  @default([])
  // Pitch compatibility, slab pricing tweaks, etc. — overrides the global
  // MACHINE_PITCH_CONFIG policy.
  metadata            Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  center              Center               @relation(fields: [centerId], references: [id], onDelete: Cascade)
  machineType         MachineType          @relation(fields: [machineTypeId], references: [id])
  resource            Resource?            @relation(fields: [resourceId], references: [id])
  bookings            Booking[]            @relation("BookingMachine")
  // OPERATOR users assigned to this specific machine row. RESOURCE_BASED
  // centers use this path; MACHINE_PITCH centers still assign by the
  // legacy MachineId enum on OperatorAssignment.
  operatorAssignments OperatorAssignment[]
  // Packages constrained to this specific machine row (RESOURCE_BASED).
  packages            Package[]

  @@unique([centerId, legacyMachineId])
  @@index([centerId, isActive])
}

// Per-center policy overrides. `Policy` (below) holds the global default;
// if a row exists here for the same key, it wins. Resolution helper lives
// in `src/lib/policy.ts`.
model CenterPolicy {
  id        String   @id @default(cuid())
  centerId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@unique([centerId, key])
  @@index([key])
}

// ─── User & Auth ─────────────────────────────────────────────────────

model User {
  id                      String               @id @default(cuid())
  name                    String?
  email                   String?              @unique
  mobileNumber            String?              @unique
  authProvider            AuthProvider
  createdAt               DateTime             @default(now())
  lastSeen                DateTime?
  role                    UserRole             @default(USER)
  // Persistent super-admin flag. Source of truth from now on; the
  // SUPER_ADMIN_EMAIL env var is kept as a bootstrap fallback.
  isSuperAdmin            Boolean              @default(false)
  // Runs the Cricket Store (Admin -> Cricket Store): products, photos,
  // prices, launch settings. A platform-level grant like isSuperAdmin,
  // NOT a center membership — the store is one catalog for all of
  // PlayOrbit. Written only by a super admin (PATCH /api/admin/users)
  // or scripts/make-admin.ts --store.
  isStoreAdmin            Boolean              @default(false)
  image                   String?
  isBlacklisted           Boolean              @default(false)
  isFreeUser              Boolean              @default(false)
  isSpecialUser           Boolean              @default(false)
  specialDiscountType     DiscountType?
  specialDiscountValue    Float?
  phonePromptDismissed    Boolean              @default(false)
  mobileVerified          Boolean              @default(false)
  bookings                Booking[]
  notifications           Notification[]
  otps                    Otp[]
  userPackages            UserPackage[]
  payments                Payment[]
  // DEPRECATED — no longer read or written by any code path. Operator
  // ordering now lives on `CenterMembership.priority` (1 = first pick),
  // managed from Admin -> Operators exactly like ground staff / coaches
  // / sidearm specialists. Kept only so the existing rows survive; safe
  // to drop in a later migration once nothing references them.
  operatorPriority        Int                  @default(0)
  operatorMorningPriority Int                  @default(0)
  operatorEveningPriority Int                  @default(0)
  operatorDayPriorities   Json? // { "0": { "morning": 1, "evening": 2 }, ... } day-specific priorities
  operatorAssignments     OperatorAssignment[]
  operatedBookings        Booking[]            @relation("OperatorBookings")
  coachedBookings         Booking[]            @relation("BookingCoach")
  sidearmBookings         Booking[]            @relation("BookingStaff")
  groundStaffBookings     Booking[]            @relation("BookingGroundStaff")
  cashPaymentUsers        CashPaymentUser[]
  wallets                 Wallet[]
  adminRefunds            Refund[]             @relation("AdminRefunds")
  centerMemberships       CenterMembership[]
  ledgerEntries           LedgerEntry[]        @relation("LedgerEntriesRecorded")
  ledgerEntriesCollected  LedgerEntry[]        @relation("LedgerEntriesCollected")
  // Marketplace (Admin -> Marketplace, /shop) + delivery addresses.
  addresses               UserAddress[]
  marketplaceInterests    MarketplaceInterest[]
  marketplaceProducts     MarketplaceProduct[] @relation("MarketplaceProductsCreated")
}

// Global policy / feature flags. Keys without a centerId in
// `CenterPolicy` use these values directly.
model Policy {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Otp {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  // Wrong guesses against this code. The WhatsApp login is the only way
  // in and the code is only 6 digits, so /api/auth/otp/verify burns the
  // code once this passes OTP_MAX_ATTEMPTS — otherwise the whole keyspace
  // is guessable inside the TTL.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// ─── Center-scoped Domain Tables ─────────────────────────────────────

model Slot {
  id        String   @id @default(cuid())
  centerId  String
  date      DateTime @db.Date
  startTime DateTime
  endTime   DateTime
  price     Float    @default(600)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@unique([centerId, date, startTime])
  @@index([centerId, date])
}

model Booking {
  id                  String                @id @default(cuid())
  centerId            String
  userId              String?
  date                DateTime              @db.Date
  startTime           DateTime
  endTime             DateTime
  status              BookingStatus         @default(BOOKED)
  ballType            BallType              @default(TENNIS)
  playerName          String
  createdAt           DateTime              @default(now())
  discountAmount      Float?
  discountType        DiscountType?
  extraCharge         Float?
  operationMode       OperationMode         @default(WITH_OPERATOR)
  originalPrice       Float?
  pitchType           PitchType?
  price               Float?
  cancellationReason  String?
  cancelledBy         String?
  createdBy           String?
  // Legacy machine reference (used by ABCA's MACHINE_PITCH booking model).
  // For RESOURCE_BASED centers this is null; the assigned Machine row is
  // recorded via `assignedMachineId` and the resource(s) consumed via
  // `BookingResourceAssignment`.
  machineId           MachineId?
  isSuperAdminBooking Boolean               @default(false)
  operatorId          String?
  paymentMethod       BookingPaymentMethod?
  paymentStatus       BookingPaymentStatus?
  kitRental           Boolean               @default(false)
  kitRentalCharge     Float?

  // ─── Resource-based booking model (phase 5) ─────────────────────
  //
  // `category` discriminates what kind of session this is:
  //   MACHINE        — bowling machine session (Yantra/Leverage/Gravity).
  //   SIDEARM        — sidearm staff bowls; consumes 1 net + 1 staff.
  //   COACHING       — personal coaching; consumes 1 net + 1 coach.
  //   FULL_COURT     — full indoor court; consumes ALL indoor nets.
  //   CORPORATE_BATCH — corporate group session; admin-only.
  // Defaults to MACHINE so every existing ABCA booking is unaffected.
  category BookingCategory @default(MACHINE)

  // Optional FKs surfaced for fast joins / dashboards. Real source of
  // truth for which Resources a booking holds is `BookingResourceAssignment`.
  assignedMachineId String?
  assignedCoachId   String?
  assignedStaffId   String?
  // The center's ground-staff member handling this facility booking
  // (Cricket Nets / Full Indoor Court / Corporate Batch). Assigned at
  // creation from the highest-priority active GROUND_STAFF membership —
  // the per-booking analogue of operatorId for machine sessions. Null for
  // MACHINE/SIDEARM/COACHING (which have their own assigned person) and
  // for legacy rows; display falls back to the center's default ground
  // staff when null.
  assignedGroundStaffId String?

  // ─── Match Practice (Corporate Batch + Match Simulation) ────────
  //
  // Corporate-batch enrollments are seat-based, not resource-based:
  // `corporateBatchMode` says how the seat was bought and
  // `enrollmentPeriod` ("2026-07", "2026-07-H1", "2026-07-H2") is set
  // for MONTHLY / HALF_MONTH memberships so capacity can be counted per
  // month without date math. Both stay null for every other category
  // (and for ADHOC rows, which count by (date, startTime) instead).
  corporateBatchMode CorporateBatchMode?
  enrollmentPeriod   String?

  // Which MATCH_SIMULATION session (MATCH_SIMULATION_CONFIG session id)
  // this seat belongs to. Set for MATCH_SIMULATION bookings so per-session
  // monthly memberships can be counted independently even when two
  // sessions share the same start time. Null for every other category and
  // for legacy match-simulation rows (which are counted by (date, startTime)).
  matchSimSessionId  String?

  center              Center                      @relation(fields: [centerId], references: [id])
  user                User?                       @relation(fields: [userId], references: [id])
  operator            User?                       @relation("OperatorBookings", fields: [operatorId], references: [id])
  assignedMachine     Machine?                    @relation("BookingMachine", fields: [assignedMachineId], references: [id])
  assignedCoach       User?                       @relation("BookingCoach", fields: [assignedCoachId], references: [id])
  assignedStaff       User?                       @relation("BookingStaff", fields: [assignedStaffId], references: [id])
  assignedGroundStaff User?                       @relation("BookingGroundStaff", fields: [assignedGroundStaffId], references: [id])
  packageBooking      PackageBooking?
  refunds             Refund[]
  resourceAssignments BookingResourceAssignment[]

  // Center-scoped uniqueness so two centers don't collide on the same
  // (date, startTime, machineId, pitchType) triple. Resource-based
  // bookings have machineId=null and pitchType=null, so this constraint
  // never fires for them — overlap is enforced via BookingResourceAssignment.
  @@unique([centerId, date, startTime, machineId, pitchType])
  @@index([status])
  @@index([userId, status])
  @@index([centerId, date, status])
  @@index([centerId, status])
  @@index([centerId, category, date])
  // Monthly / half-month corporate-batch capacity counting.
  @@index([centerId, category, enrollmentPeriod])
  // Per-session match-simulation monthly membership counting.
  @@index([centerId, category, matchSimSessionId, enrollmentPeriod], map: "Booking_centerId_category_matchSimSessionId_enrollmentPeri_idx")
  @@index([operatorId])
  @@index([assignedMachineId])
  @@index([assignedCoachId])
  @@index([assignedStaffId])
  @@index([assignedGroundStaffId])
}

enum BookingCategory {
  MACHINE
  SIDEARM
  COACHING
  FULL_COURT
  CORPORATE_BATCH
  // Bare-net booking — user reserves a single net (indoor or outdoor)
  // with no machine, no staff, no coach. Pitch type is picked by the
  // user from the per-center NET_PITCH_TYPES policy. Mostly used for
  // bring-your-own-bowler practice or warm-up sessions.
  NET
  // Match Practice → Match Simulation: seat-based group session
  // (capacity per configured session, no machine/pitch/operator).
  // Sessions are defined in the MATCH_SIMULATION_CONFIG center policy.
  MATCH_SIMULATION
}

// How a CORPORATE_BATCH booking row was purchased. Corporate batch is a
// seat-based enrollment product (Match Practice → Corporate Batch):
//   MONTHLY    — one row per user per month (enrollmentPeriod "YYYY-MM")
//   HALF_MONTH — one row per user per half-month ("YYYY-MM-H1" / "-H2")
//   REGULAR    — one row per user per attended session date (renamed
//                from ADHOC in-place via migration; no data movement)
enum CorporateBatchMode {
  MONTHLY
  HALF_MONTH
  REGULAR
}

// Many-to-many between a Booking and the Resources (nets/courts/turf
// wickets) it consumes. A FULL_COURT booking has 4 rows here (one per
// indoor net); a single-net booking has 1. Used to compute "is resource
// X free during [t1, t2)?".
model BookingResourceAssignment {
  id         String   @id @default(cuid())
  bookingId  String
  resourceId String
  createdAt  DateTime @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([bookingId, resourceId])
  @@index([resourceId])
}

// A range of dates/times where bookings are forbidden. Dual-axis like
// OperatorAssignment — the legacy fields target the ABCA enum world
// (machineId, machineIds = MachineId enum strings, machineType,
// pitchType), and the new fields target RESOURCE_BASED entities:
//
//   - machineRowIds  Machine.id FKs (Toplay's specific machines)
//   - resourceIds    Resource.id FKs (specific nets/wickets)
//   - categories     BookingCategory enum (block all SIDEARM bookings,
//                    all FULL_COURT, etc.)
//
// Empty new-axis arrays + empty legacy fields = catchall block (every
// booking in the time window). Mixed axes intersect (a category-only
// block matches only that category's bookings).
model BlockedSlot {
  id             String            @id @default(cuid())
  centerId       String
  startDate      DateTime          @db.Date
  endDate        DateTime          @db.Date
  startTime      DateTime?
  endTime        DateTime?
  machineType    BallType?
  pitchType      PitchType?
  reason         String?
  blockedBy      String
  createdAt      DateTime          @default(now())
  machineId      MachineId?
  recurringDays  Int[]
  machineIds     String[]
  appliesTo      String            @default("ALL") // "ALL", "SPECIAL", "NON_SPECIAL"
  // Resource-based targeting (Toplay et al.). All default to empty
  // arrays so existing ABCA blocks behave unchanged.
  machineRowIds  String[]          @default([])
  resourceIds    String[]          @default([])
  categories     BookingCategory[] @default([])
  // Partial cricket-net blocking. NULL = block all indoor nets at this
  // window (legacy behaviour); a positive integer N = block N nets out
  // of the indoor pool, leaving the rest bookable. Only consulted by
  // the availability engine when this row targets the indoor net pool
  // (no resourceIds pin, NET / CRICKET-NET / catchall semantics) —
  // otherwise the engine still blocks every targeted resource.
  netCount       Int?

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId, startDate, endDate])
}

// A buyable package of session credits. ABCA-shaped fields (machineId,
// machineType, ballType, wicketType, pitchTypes) target the legacy
// MACHINE_PITCH model. The new `category` + `machineRowId` fields make
// the same model usable for RESOURCE_BASED centers (Toplay), where
// each package represents N sessions of a specific BookingCategory
// (MACHINE / SIDEARM / COACHING / NET / FULL_COURT) optionally
// constrained to a specific Machine row.
model Package {
  id               String             @id @default(cuid())
  centerId         String
  name             String
  machineId        MachineId?
  machineType      PackageMachineType
  ballType         PackageBallType?
  wicketType       PackageWicketType?
  timingType       TimingType
  totalSessions    Int
  validityDays     Int                @default(30)
  price            Float
  extraChargeRules Json?
  isActive         Boolean            @default(true)
  isCustom         Boolean            @default(false)
  // Resource-based fields (Toplay). category + optional machineRowId
  // tell the engine which RESOURCE_BASED bookings can redeem this
  // package's sessions. Null = legacy ABCA package (no category gate).
  category         BookingCategory?
  machineRowId     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  userPackages     UserPackage[]

  center     Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  machineRow Machine? @relation(fields: [machineRowId], references: [id], onDelete: SetNull)

  @@index([centerId, isActive])
}

model UserPackage {
  id              String            @id @default(cuid())
  userId          String
  packageId       String
  totalSessions   Int
  usedSessions    Int               @default(0)
  activationDate  DateTime?
  expiryDate      DateTime?
  status          UserPackageStatus @default(ACTIVE)
  amountPaid      Float
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  auditLogs       PackageAuditLog[]
  packageBookings PackageBooking[]
  package         Package           @relation(fields: [packageId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
}

model PackageBooking {
  id              String      @id @default(cuid())
  userPackageId   String
  bookingId       String      @unique
  sessionsUsed    Int         @default(1)
  extraCharge     Float       @default(0)
  extraChargeType String?
  createdAt       DateTime    @default(now())
  booking         Booking     @relation(fields: [bookingId], references: [id])
  userPackage     UserPackage @relation(fields: [userPackageId], references: [id])
}

model PackageAuditLog {
  id            String      @id @default(cuid())
  userPackageId String
  action        String
  details       Json?
  performedBy   String
  createdAt     DateTime    @default(now())
  userPackage   UserPackage @relation(fields: [userPackageId], references: [id])
}

model Notification {
  id                String                 @id @default(cuid())
  userId            String
  title             String
  message           String
  type              String                 @default("INFO")
  isRead            Boolean                @default(false)
  createdAt         DateTime               @default(now())
  channel           NotificationChannel    @default(IN_APP)
  whatsappMessageId String?
  whatsappStatus    WhatsAppMessageStatus?
  // Optional link to the booking this alert is about (confirmation /
  // cancellation / refund notifications). Lets the in-app Alerts view
  // render the full Bookings-page card as a snapshot instead of just a
  // text summary. Plain scalar (no FK relation) so a hard-deleted
  // booking simply yields a null lookup rather than blocking the delete;
  // the notifications API tolerates a missing booking gracefully.
  bookingId         String?
  user              User                   @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ─── Wallet ──────────────────────────────────────────────────────────
//
// Wallets are CENTER-SCOPED: each user has at most one wallet per center.
// A refund issued at ABCA credits an ABCA wallet; balances cannot be
// spent across centers. (Razorpay accounts are also per-center, so this
// matches the money-flow boundary.)
//
// Future option — global wallets: add a `WALLET_SCOPE` policy ('CENTER'
// or 'GLOBAL'); when GLOBAL, code resolves a single wallet per user and
// ignores the centerId column (which would be relaxed to nullable). Not
// implemented today; flagged for when the business asks for it.
//
// `Center` relation:                       wallets        Wallet[]

model Wallet {
  id           String              @id @default(cuid())
  userId       String
  centerId     String
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id])
  center       Center              @relation(fields: [centerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@unique([userId, centerId])
  @@index([centerId])
}

model WalletTransaction {
  id          String                @id @default(cuid())
  walletId    String
  type        WalletTransactionType
  amount      Float
  balance     Float // Balance after this transaction
  description String?
  referenceId String? // Booking ID, Payment ID, etc.
  createdAt   DateTime              @default(now())
  wallet      Wallet                @relation(fields: [walletId], references: [id])

  @@index([walletId])
  // The booking-payment wallet-ledger fallback filters DEBIT_BOOKING rows by
  // referenceId (booking id).
  @@index([referenceId])
}

