PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/booking_db?schema=public&options=-c%20TimeZone%3DAsia%2FKolkata"
DATABASE_URL="postgresql://user:password@localhost:5432/booking_db?schema=public&options=-c%20TimeZone%3DAsia%2FKolkata"
TZ="Asia/Kolkata"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"
JWT_SECRET="your-very-secure-jwt-secret"
OTP_TTL_MINUTES="10"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
SUPER_ADMIN_EMAIL="your-super-admin-email@example.com"

# ─── WhatsApp OTP Provider ───────────────────────────────────────
# Twilio WhatsApp (recommended — set all 3 to activate)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Meta Cloud API (legacy fallback — used only if Twilio vars are absent)
# WHATSAPP_PHONE_NUMBER_ID="your-meta-phone-number-id"
# WHATSAPP_ACCESS_TOKEN="your-permanent-system-user-token"
# WHATSAPP_OTP_TEMPLATE="otp_login"
# WHATSAPP_API_URL=""  # Optional: override Graph API base URL

# ─── Staff booking alerts (operator / coach / specialist / ground staff) ──
# New-booking alerts to staff go via an approved WhatsApp template so they
# deliver outside the 24h conversation window (free-form text would be
# dropped). If UNSET, the already-approved customer `booking_detail` template
# is reused — works immediately, no extra setup. Set this to the name of a
# separately-approved 8-param staff template to send a richer message that
# also includes the customer's name + phone. See docs/whatsapp-templates.md.
# WHATSAPP_STAFF_BOOKING_TEMPLATE="staff_booking_alert"
# Cancellation alerts to staff use the same approach. If UNSET, the approved
# customer `booking_cancelled` template is reused. Set this to a separately-
# approved 8-param staff-cancel template for a richer, role-aware message.
# WHATSAPP_STAFF_CANCEL_TEMPLATE="staff_cancel_alert"
# Per-center map link in booking confirmations. The booking_detail template
# has a STATIC maps link baked in (one center's), so every center shows it.
# Re-approve booking_detail with a trailing "📍 {{8}}" placeholder, then set
# this to 'true' — the code fills {{8}} with each booking center's own mapUrl.
# Leave UNSET until the template actually has {{8}} (else Meta rejects sends).
# WHATSAPP_BOOKING_DETAIL_LOCATION_ENABLED="true"

# ─── SMS OTP Provider ────────────────────────────────────────────
# 2Factor.in (recommended — best for Indian OTP, handles DLT)
# Sign up at https://2factor.in and get API key from dashboard
TWOFACTOR_API_KEY="your-2factor-api-key"

# Fast2SMS (fallback — used if TWOFACTOR_API_KEY is absent)
# FAST2SMS_API_KEY="your-fast2sms-api-key"

# ─── Maintenance Mode (env kill-switch) ──────────────────────────
# When "true", middleware rewrites ALL traffic to /maintenance without
# touching the DB (works even while the database is mid-migration / down).
# No admin bypass — this locks everyone out, which is intended during a
# DB cutover. Set in Vercel env + redeploy to flip; unset (or "false") +
# redeploy to lift.
# MAINTENANCE_MODE="false"
# MAINTENANCE_MESSAGE="We're upgrading PlayOrbit. We'll be back shortly."
# MAINTENANCE_ETA="around 11:30 PM IST"
# Verification bypass: visit https://<site>/?mbk=<this-value> while in
# maintenance to drop a cookie that lets your browser through (8h). Use a
# long random secret. Auth-free + DB-free, so it works during a DB migration.
# MAINTENANCE_BYPASS_KEY="set-a-long-random-secret"
